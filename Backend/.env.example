# Copy this file to .env and fill in the values.

# MongoDB connection string.
# For local/dev you can use the bundled in-memory DB via `npm run dev:mem`
# (no MONGO_URI needed in that mode). For a real DB, set your URI here:
MONGO_URI=mongodb://127.0.0.1:27017/interview-ai

# Secret used to sign JWT auth tokens. Use any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Google Generative AI (Gemini) API key.
# Required for the AI interview-report and resume-PDF features.
# Get one at https://aistudio.google.com/app/apikey
GOOGLE_GENAI_API_KEY=
