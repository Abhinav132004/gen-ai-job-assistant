# Copy this file to .env and fill in the values.

# MongoDB connection string.
# For local/dev you can use the bundled in-memory DB via `npm run dev:mem`
# (no MONGO_URI needed in that mode). For a real DB (e.g. MongoDB Atlas),
# set your connection string here:
MONGO_URI=mongodb://127.0.0.1:27017/interview-ai

# Secret used to sign JWT auth tokens. Use any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Google Generative AI (Gemini) API key.
# Required for the AI interview-report and resume-PDF features.
# Get one at https://aistudio.google.com/app/apikey
GOOGLE_GENAI_API_KEY=

# The deployed frontend URL, used for CORS. In local dev this is not needed
# (http://localhost:5173 is always allowed). In production set it to your
# frontend URL, e.g. https://your-frontend.onrender.com
FRONTEND_URL=

# Set to "production" when deployed. This makes the auth cookie Secure and
# SameSite=None so it works across the deployed frontend/backend domains.
NODE_ENV=development
